{
  "name": "@pyre/core",
  "version": "0.1.19",
  "description": "Shared TypeScript contracts for Pyre packages",
  "license": "MIT",
  "type": "module",
  "main": "./index.ts",
  "module": "./index.ts",
  "types": "./index.ts",
  "exports": {
    "./local-edits": { "types": "./local-edits.ts", "default": "./local-edits.ts" },
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    }
  },
  "files": [
    "local-edits.ts",
    "index.ts",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  }
}
