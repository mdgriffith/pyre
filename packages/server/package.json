{
  "name": "@pyre/server",
  "version": "0.1.19",
  "description": "Server runtime for executing generated Pyre queries",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "profile:sync": "bun run ./sync-lifecycle.profile.ts",
    "test": "bun test",
    "test:local-edits": "bun test local-edits.test.ts",
    "seed:local-edits": "bun fixtures/local-edits/generate.ts && bun fixtures/local-edits/seed.ts",
    "typecheck:local-edits": "bun fixtures/local-edits/generate.ts && tsc --noEmit -p fixtures/local-edits/tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "main": "./index.ts",
  "module": "./index.ts",
  "types": "./index.ts",
  "exports": {
    "./local-edits": {
      "types": "./local-edits.ts",
      "default": "./local-edits.ts"
    },
    "./context": {
      "types": "./context.ts",
      "default": "./context.ts"
    },
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./query": {
      "types": "./query.ts",
      "default": "./query.ts"
    },
    "./wasm": {
      "types": "./wasm.ts",
      "default": "./wasm.ts"
    },
    "./schema": {
      "types": "./schema.ts",
      "default": "./schema.ts"
    },
    "./sync": {
      "types": "./sync-api.ts",
      "default": "./sync-api.ts"
    },
    "./query-sync": {
      "types": "./query-sync.ts",
      "default": "./query-sync.ts"
    },
    "./runtime/sql": {
      "types": "./runtime/sql.ts",
      "default": "./runtime/sql.ts"
    },
    "./runtime/runner": {
      "types": "./runtime/runner.ts",
      "default": "./runtime/runner.ts"
    }
  },
  "dependencies": {
    "@pyre/core": "0.1.19",
    "@libsql/client": "^0.14.0"
  },
  "peerDependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "zod": "4.3.6"
  },
  "files": [
    "context.ts",
    "index.ts",
    "init.ts",
    "local-edits.ts",
    "database-id.ts",
    "query-sync.ts",
    "query.ts",
    "runtime",
    "schema.ts",
    "sync-api.ts",
    "sync.ts",
    "wasm-json.ts",
    "wasm.ts",
    "wasm/pyre_wasm.js",
    "wasm/pyre_wasm_bg.wasm",
    "wasm/pyre_wasm.d.ts",
    "wasm/pyre_wasm_bg.wasm.d.ts",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  }
}
