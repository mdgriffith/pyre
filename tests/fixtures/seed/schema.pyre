@syncable(false)
type Status
    = Draft
    | Published { note String }

type Color = Red | Blue

record User {
    id Id.Int @id
    name String @default("Anonymous")
    posts @link(Post.authorId)
    @public
}

record Post {
    id Id.Int @id
    authorId User.id
    title String
    metadata Json
    status Status
    jsonStatus Json<Status>?
    groupedStatus Json<Dict<List<Status?>>>?
    color Color?
    jsonColor Json<Color>?
    publishedAt DateTime?
    author @link(authorId, User.id)
    @public
}
